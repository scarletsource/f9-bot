def get_status(uuid):

    statuses = load_statuses()

    print("LOAD:")
    print(statuses)

    return statuses.get(
        uuid,
        "free"
    )

def set_status(uuid, status):

    statuses = load_statuses()

    statuses[uuid] = status

    save_statuses(statuses)

    print("SAVE:")
    print(statuses)
